# ==============================================================================
# CohortLens / ÆGIS Retail - Environment Variables Configuration Template
# Pragyan 2K26 Track 2-03: Privacy-Preserving Consumer Intelligence
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# Application runtime mode: 'development' | 'production' | 'test'
# Note: For Vite builds, keep commented or use APP_ENV so Vite doesn't warn.
# In production containers/servers, pass NODE_ENV=production via OS environment.
# NODE_ENV=production
APP_ENV=production

# Server listening port (default: 5000)
PORT=5000

# Server host binding ('0.0.0.0' for docker/production, '127.0.0.1' for local dev)
HOST=0.0.0.0

# Allowed CORS origins (comma-separated list, or '*' for unrestricted)
# In production, set this to your exact frontend domain(s)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ------------------------------------------------------------------------------
# 2. CLIENT-SIDE / FRONTEND CONFIGURATION (Vite requires VITE_ prefix)
# ------------------------------------------------------------------------------
# Full API endpoint URL for the React client.
# In local dev: http://127.0.0.1:5000/api
# In production (if hosted on the same domain via Express static or reverse proxy): /api
# In decoupled production (e.g. Vercel frontend + Render backend): https://api.yourdomain.com/api
VITE_API_URL=http://127.0.0.1:5000/api

# ------------------------------------------------------------------------------
# 3. CRYPTOGRAPHIC & PRIVACY CONTROLS (DPDP Act 2023 Compliant)
# ------------------------------------------------------------------------------
# Secret salt for HMAC-SHA256 pseudonymisation (T1 Raw -> T2 Minimised transformation).
# MUST be a strong, randomly generated string in production (min 32 characters).
HMAC_SECRET_SALT=shop_secret_vault_key_2026_salt_99812_change_in_production

# Differential Privacy Epsilon (budget epsilon for Laplace noise injection on k-anonymised counts)
# Recommended range: 0.25 to 1.0 (Lower = higher privacy, higher = more analytical precision)
DP_EPSILON=0.5

# k-Anonymity minimum cohort threshold (any cohort smaller than k is suppressed or merged)
K_ANONYMITY_THRESHOLD=10

# Counter QR 2-step deletion OTP expiration window (in milliseconds, default: 300000 = 5 minutes)
OTP_EXPIRY_MS=300000

# ------------------------------------------------------------------------------
# 4. BLIND-SEND & COMMUNICATIONS ENCLAVE (Optional Integrations)
# ------------------------------------------------------------------------------
# Mode for dispatching SMS/WhatsApp: 'simulated' | 'live'
BLIND_SEND_MODE=simulated

# WhatsApp Cloud API credentials (used only inside the zero-retention Blind-Send Enclave)
# The store owner never sees the recipient phone numbers; only the enclave resolves them.
WHATSAPP_API_TOKEN=your_whatsapp_business_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# SMS Gateway credentials (e.g., Twilio / Fast2SMS / MSG91)
SMS_GATEWAY_API_KEY=your_sms_gateway_api_key
SMS_SENDER_ID=COHORT
